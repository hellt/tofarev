{
  "name": "tofarev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:opencode": "npm run build && node --test dist/test/opencode.integration.js",
    "preview": "npm run build && node dist/src/cli.js preview",
    "probe": "npm run build && node dist/src/cli.js probe",
    "evaluate": "npm run build && node dist/src/cli.js evaluate",
    "check": "npm run typecheck && npm test",
    "test:e2e": "npm run build && node --test dist/test/pipeline.integration.js",
    "test:container": "sh scripts/test-container.sh"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "opencode-ai": "1.18.33",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
